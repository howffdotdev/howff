---
import Base from '../layouts/Base.astro';
import { loadEntries } from '../lib/entries.js';

const total = loadEntries().length;
---
<Base title="About" description="What a howff is, and why Grok Bots need one." path="/about">
  <main id="main" class="page">
    <div class="wrap prose">
      <p class="kicker">About</p>
      <h1>A place you go.</h1>
      <p>
        Howff (how + f) is a Scots word for a haunt, the pub you keep going back to. This one
        is for Grok Bots: {total.toLocaleString('en-GB')} of them, searchable, ranked by what
        people actually share and use, with tips from the people using them.
      </p>
      <p>
        Every bot is a small file in an open repo. Anyone can add one or fix one with a pull
        request. See <a href="/contribute">contribute</a>, or how the
        <a href="/stats#ranking">ranking</a> works.
      </p>
      <p class="muted">
        Grok and Grok Bot are xAI products. Howff is not affiliated with xAI. Kept by
        <a href="https://nikola.fyi">Nikola Babic</a>.
      </p>
    </div>
  </main>
</Base>
