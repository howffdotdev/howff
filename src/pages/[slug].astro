---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BotCard from '../components/BotCard.astro';
import CopyButton from '../components/CopyButton.astro';
import { loadEntries, related, readInstructions, CATEGORY_LABEL } from '../lib/entries.js';
import { botMark } from '../lib/botmark.js';
import TipCard from '../components/TipCard.astro';
import { popularityBySlug, tipsFor, signalLine, shortDate } from '../lib/signals.js';

export async function getStaticPaths() {
  const docs = await getCollection('instructions');
  const byId = new Map(docs.map((d) => [d.id, d]));
  return loadEntries().map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, doc: entry.instructions ? byId.get(entry.slug) : undefined },
  }));
}

const { entry, doc } = Astro.props;
const { Content } = doc ? await render(doc) : { Content: null };

// The rendered markdown is for reading; the raw file is what gets copied, so
// the clipboard holds a prompt you can paste straight into Grok.
const raw = readInstructions(entry);
const also = related(entry);
const isShare = entry.add.kind === 'share-link';
// Attribution is a licence condition for CC-BY, so it stays whenever the
// instructions are shown.
const cc = entry.license?.startsWith('CC-BY');
const mark = botMark(entry.slug, entry.category, { size: 64, attrs: 'aria-hidden="true"' });
const pop = popularityBySlug().get(entry.slug);
const tips = tipsFor(entry.slug);
---
<Base
  title={entry.name}
  description={entry.tagline}
  path={`/${entry.slug}`}
  ogImage={`/og/${entry.slug}.png`}
  ogImageAlt={`${entry.name} on Howff. ${entry.tagline}`}
>
  <main id="main" class="wrap entry">
    <div>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> · <a href={`/c/${entry.category}`}>{CATEGORY_LABEL[entry.category]}</a>
      </nav>
      <div class="entry-head">
        <span class="botmark botmark-lg" set:html={mark} />
        <div>
          <h1>{entry.name}</h1>
          <p class="tagline">{entry.tagline}</p>
        </div>
      </div>
      <p class="entry-byline">
        <a class="cat" href={`/c/${entry.category}`} style={`--cat: var(--cat-${entry.category})`}>
          {CATEGORY_LABEL[entry.category]}
        </a>
        <span>by {entry.author ?? 'anon'}</span>
        <span>added {shortDate(entry.added, true)}</span>
        {pop && pop.score > 0 && <span>{signalLine(pop.signals)}</span>}
      </p>

      <div class="add-row">
        {isShare ? (
          <>
            <a
              class="btn lg"
              href={entry.add.url}
              target="_blank"
              rel="noreferrer"
              data-umami-event="add-bot"
              data-umami-event-bot={entry.slug}
            >
              Add to Grok Bot ↗
            </a>
            <CopyButton text={entry.add.url} label="Copy link" ghost />
          </>
        ) : (
          <div class="panel add-panel">
            <div class="panel-body">
              <p style="margin: 0">Paste this URL as the first message in a new Grok Bot chat.</p>
              <div class="url-box">
                <code>{entry.add.url}</code>
                <CopyButton text={entry.add.url} label="Copy URL" />
              </div>
            </div>
          </div>
        )}
      </div>
      {entry.add.hint && <p class="notice">{entry.add.hint}</p>}

      <div class="prose">
        <p>{entry.description}</p>
      </div>
      {entry.integrations.length > 0 && (
        <p class="entry-tools">
          <span class="muted">Connects to</span>
          {entry.integrations.map((name) => <span class="chip">{name}</span>)}
        </p>
      )}

      {tips.length > 0 && (
        <section class="entry-tips" aria-labelledby="tips-h">
          <h2 id="tips-h" class="kicker">Tips from X</h2>
          <div class="tips">
            {tips.map((t) => <TipCard tip={t} showBot={false} />)}
          </div>
        </section>
      )}

      {raw && (
        <section class="panel instructions" aria-labelledby="ins-h">
          <div class="panel-head">
            <h2 id="ins-h">Instructions</h2>
            <div class="actions">
              <button type="button" class="pill" id="expand" aria-expanded="false" hidden>
                Show all
              </button>
              <CopyButton text={raw} label="Copy instructions" done="Copied ✓" />
            </div>
          </div>
          {/* The CSS cap is only safe because JS supplies the expand control. */}
          <noscript>
            <style is:inline>
              .instructions-body { max-height: none; }
              .instructions-body::after { content: none; }
            </style>
          </noscript>
          <div class="instructions-body" id="ins-body">
            <div><Content /></div>
          </div>
          {(entry.license || entry.source) && (
            <p class="panel-foot">
              By {entry.author ?? 'unknown'}
              {entry.license && ` · ${entry.license}`}
              {entry.source && <> · <a href={entry.source}>source</a></>}
              {cc && ' · attribution required if you republish'}
            </p>
          )}
        </section>
      )}
    </div>

    {also.length > 0 && (
      <aside class="entry-side" aria-labelledby="also-h">
        <h2 id="also-h" class="kicker">More like this</h2>
        <div class="related">
          {also.map((e) => <BotCard entry={e} />)}
        </div>
      </aside>
    )}
  </main>
  <script src="../scripts/copy.js"></script>
  <script src="../scripts/instructions.js"></script>
</Base>
