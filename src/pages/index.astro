---
import Base from '../layouts/Base.astro';
import Shelf from '../components/Shelf.astro';
import { loadEntries } from '../lib/entries.js';

const entries = loadEntries();
const description =
  'An open shelf of Grok Bots. Read the full instructions, then add one in a click.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Howff',
  url: 'https://howff.dev',
  description,
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://howff.dev/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---
<Base title="Howff" description={description} path="/">
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="kicker">{entries.length} Grok Bots</p>
        <h1>Grok Bots you can <span>read</span> before you run.</h1>
        <p class="pronounce">HOWFF · how + f · a Scots meeting-place</p>
        <p class="lede">
          Every bot here shows its full instructions. Copy the prompt, or add the bot in one
          click. One JSON file and one markdown file per bot, in the open, in the repo.
        </p>
        <div class="hero-actions">
          <a class="btn lg" href="#list">Browse the shelf</a>
          <a class="btn ghost lg" href="/submit">Add your bot</a>
        </div>
      </div>
    </section>
    <div class="wrap">
      <Shelf entries={entries} />
    </div>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script src="../scripts/shelf.js"></script>
</Base>
