---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Shelf from '../components/Shelf.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Howff',
  url: 'https://howff.dev',
  description: 'A haunt for bot templates, skills, and MCPs.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://howff.dev/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---
<Base title="Howff" description="A haunt for bot templates, skills, and MCPs." path="/">
  <Header />
  <Shelf />
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script src="../scripts/shelf.js"></script>
</Base>
