---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import BotCard from '../../components/BotCard.astro';
import { loadPopularity, signalLine } from '../../lib/signals.js';
import {
  loadEntries,
  byCategory,
  CATEGORIES,
  CATEGORY_LABEL,
  CATEGORY_BLURB,
} from '../../lib/entries.js';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const label = CATEGORY_LABEL[category];
const entries = byCategory(category, loadEntries());
const inCat = new Map(entries.map((e) => [e.slug, e]));
const top = loadPopularity()
  .bots.filter((b) => b.score > 0 && inCat.has(b.slug))
  .slice(0, 4);
const description = `${label} Grok Bots on Howff. ${CATEGORY_BLURB[category]}`;
---
<Base title={label} description={description} path={`/c/${category}`}>
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="kicker"><a href="/all">All bots</a> · {label}</p>
        <h1>{label}</h1>
        <p class="lede">{CATEGORY_BLURB[category]}</p>
      </div>
    </section>
    <div class="wrap">
      {top.length > 0 && (
        <section class="home-section" aria-labelledby="top-h">
          <div class="section-head">
            <h2 id="top-h">Most used in {label}</h2>
          </div>
          <ol class="list top-list">
            {top.map((b, i) => (
              <li><BotCard entry={inCat.get(b.slug)} rank={i + 1} note={signalLine(b.signals)} /></li>
            ))}
          </ol>
        </section>
      )}
      {entries.length > 0 ? (
        <Shelf entries={entries} scope={category} />
      ) : (
        <div class="empty">
          <p>Nothing filed under {label} yet. The first one is yours.</p>
          <div class="actions" style="justify-content: center">
            <a class="btn" href="/submit">Add a bot</a>
            <a class="btn ghost" href="/all">Browse everything</a>
          </div>
        </div>
      )}
    </div>
  </main>
  {entries.length > 0 && <script src="../../scripts/shelf.js"></script>}
</Base>
