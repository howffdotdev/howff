---
import Base from '../layouts/Base.astro';
import { loadEntries, stats as fromData, CATEGORY_LABEL } from '../lib/entries.js';
import { loadPopularity, short, shortDate } from '../lib/signals.js';

const entries = loadEntries();
const s = fromData(entries);
const pop = loadPopularity();
const names = new Map(entries.map((e) => [e.slug, e.name]));
const ranked = pop.bots.filter((b) => b.score > 0 && names.has(b.slug));
const xSource = pop.sources.find((src) => src.file?.includes('x-posts'));
---
<Base title="Stats" description="How Howff ranks bots, and what is on the shelf." path="/stats">
  <main id="main" class="page">
    <div class="wrap">
      <p class="kicker">Stats</p>
      <h1>{s.total.toLocaleString('en-GB')} on the shelf</h1>

      <section id="ranking" class="prose" style="margin-top: 2rem">
        <h2>How "most used" is ranked</h2>
        <p>
          xAI does not publish install counts for shared bots, so Howff uses the next best
          public signal: people sharing a bot on X, and how much others like, repost and save
          those posts. Recent posts count more. A post that links several bots splits its weight
          between them, and each extra person who shares a bot adds a bonus.
        </p>
        <p class="muted">
          {ranked.length} bots have a signal so far
          {xSource?.fetchedAt && <> · X data from {shortDate(xSource.fetchedAt, true)}</>}
          · <a href="https://github.com/howffdotdev/howff/blob/main/data/popularity.json">raw data</a>
        </p>
      </section>

      <div class="grid-2" style="margin-top: 2rem">
        <div>
          <h2 class="kicker">Top 20</h2>
          <table class="stat-table">
            <thead><tr><th>Bot</th><th>Sharers</th><th>Likes</th><th>Score</th></tr></thead>
            <tbody>
              {ranked.slice(0, 20).map((b) => (
                <tr>
                  <td><a href={`/${b.slug}`}>{names.get(b.slug)}</a></td>
                  <td class="num">{b.signals.sharers}</td>
                  <td class="num">{short(b.signals.likes)}</td>
                  <td class="num">{b.score}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div>
          <h2 class="kicker">By category</h2>
          <table class="stat-table">
            <tbody>
              {Object.entries(s.byCategory).map(([k, v]) => (
                <tr><td><a href={`/c/${k}`}>{CATEGORY_LABEL[k]}</a></td><td class="num">{v}</td></tr>
              ))}
            </tbody>
          </table>
          <h2 class="kicker" style="margin-top: 2rem">By tool</h2>
          <table class="stat-table">
            <tbody>
              {s.integrations.map(([k, v]) => (
                <tr><td>{k}</td><td class="num">{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</Base>
