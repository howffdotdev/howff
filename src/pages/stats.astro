---
import Base from '../layouts/Base.astro';
import { loadEntries, stats as fromData, CATEGORY_LABEL, ADD_LABEL } from '../lib/entries.js';

const s = fromData(loadEntries());
---
<Base title="Stats" description="Counts from the Howff dataset. Nothing else." path="/stats">
  <main id="main" class="page">
    <div class="wrap">
      <p class="kicker">Stats</p>
      <h1>{s.total} on the shelf</h1>
      <p class="muted">
        Counted from <code>data/entries/</code> at build time. No invented analytics.
      </p>
      <div class="grid-2" style="margin-top: 2rem">
        <div>
          <h2 class="kicker">By category</h2>
          <table class="stat-table">
            <thead><tr><th>Category</th><th></th></tr></thead>
            <tbody>
              {Object.entries(s.byCategory).map(([k, v]) => (
                <tr><td><a href={`/c/${k}`}>{CATEGORY_LABEL[k]}</a></td><td class="num">{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div>
          <h2 class="kicker">By integration</h2>
          <table class="stat-table">
            <thead><tr><th>Connects to</th><th></th></tr></thead>
            <tbody>
              {s.integrations.map(([k, v]) => (
                <tr><td>{k}</td><td class="num">{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div>
          <h2 class="kicker">By licence</h2>
          <table class="stat-table">
            <thead><tr><th>Licence</th><th></th></tr></thead>
            <tbody>
              {s.byLicense.map(([k, v]) => (
                <tr><td>{k}</td><td class="num">{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div>
          <h2 class="kicker">How you add them</h2>
          <table class="stat-table">
            <thead><tr><th>Method</th><th></th></tr></thead>
            <tbody>
              {Object.entries(s.byAdd).map(([k, v]) => (
                <tr><td>{ADD_LABEL[k]}</td><td class="num">{v}</td></tr>
              ))}
              <tr><td>With full instructions</td><td class="num">{s.withInstructions}</td></tr>
              <tr><td>Checked</td><td class="num">{s.verified}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      {s.tags.length > 0 && (
        <div style="margin-top: 2rem">
          <h2 class="kicker">Tags</h2>
          <table class="stat-table">
            <thead><tr><th>Tag</th><th></th></tr></thead>
            <tbody>
              {s.tags.map(([k, v]) => (
                <tr><td>{k}</td><td class="num">{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </main>
</Base>
