---
import { CATEGORY_LABEL } from '../lib/entries.js';

// scope is 'all' on the homepage, or a category slug on /c/<category>. When
// scoped, category is fixed by the URL so the pills become plain links out.
const { entries, categories, integrations, tags, scope = 'all' } = Astro.props;
const scoped = scope !== 'all';
---
<form class="filters" id="filters" role="search" aria-label="Search the shelf" action="/" method="get">
  <div class="filters-top">
    <label class="field search-field" for="q">
      Search
      <span class="search-wrap">
        <input
          id="q"
          type="search"
          name="q"
          placeholder="name, tool, tag, or anything in the instructions…"
          autocomplete="off"
        />
        <kbd aria-hidden="true">/</kbd>
      </span>
    </label>
    <label class="field sort-field" for="sort">
      Sort
      <select id="sort" name="sort">
        <option value="new">Newest first</option>
        <option value="az">A to Z</option>
      </select>
    </label>
    <noscript><button type="submit">Search</button></noscript>
  </div>

  <div class="facets">
    <div class="pill-row" role="group" aria-labelledby="cat-label">
      <p class="pill-label" id="cat-label">Category</p>
      <div class="pills" id="cat-pills">
        {scoped ? (
          <a class="pill" href="/">All</a>
        ) : (
          <button type="button" class="pill" data-cat="all" aria-pressed="true">All</button>
        )}
        {categories.map(([cat, n]) =>
          scoped ? (
            <a
              class="pill"
              href={`/c/${cat}`}
              style={`--cat: var(--cat-${cat})`}
              aria-current={cat === scope ? 'page' : undefined}
            >{CATEGORY_LABEL[cat]} <span class="n">{n}</span></a>
          ) : (
            <button type="button" class="pill" data-cat={cat} aria-pressed="false">
              {CATEGORY_LABEL[cat]} <span class="n">{n}</span>
            </button>
          ),
        )}
      </div>
    </div>

    {integrations.length > 0 && (
      <div class="pill-row" role="group" aria-labelledby="int-label">
        <p class="pill-label" id="int-label">Connects to</p>
        <div class="pills" id="int-pills">
          <button type="button" class="pill" data-int="all" aria-pressed="true">Any</button>
          {integrations.map(([name, n]) => (
            <button type="button" class="pill" data-int={name} aria-pressed="false">
              {name} <span class="n">{n}</span>
            </button>
          ))}
        </div>
      </div>
    )}

    {tags.length > 0 && (
      <label class="field tag-field" for="tag">
        Tag
        <select id="tag" name="tag">
          <option value="all">Any tag</option>
          {tags.map(([t, n]) => <option value={t}>{t} ({n})</option>)}
        </select>
      </label>
    )}
  </div>
</form>

<div class="shelf-meta">
  <p class="count" id="count" role="status">
    {entries.length === 1 ? '1 bot' : `${entries.length} bots`}
  </p>
  <button type="button" class="pill clear" id="clear" hidden>Clear filters</button>
</div>
