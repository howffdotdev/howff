---
import BotCard from './BotCard.astro';
import FilterBar from './FilterBar.astro';
import {
  allTags,
  allIntegrations,
  categoryCounts,
  readInstructions,
} from '../lib/entries.js';

const { entries, scope = 'all' } = Astro.props;

// Facets are counted from what is on screen, so a category page never offers a
// filter that would empty the grid.
const categories = categoryCounts(entries);
const integrations = allIntegrations(entries);
const tags = allTags(entries);
const instructions = new Map(entries.map((e) => [e.slug, readInstructions(e) ?? '']));
---
<FilterBar
  entries={entries}
  categories={categories}
  integrations={integrations}
  tags={tags}
  scope={scope}
/>
<div class="list" id="list">
  {entries.map((entry) => (
    <BotCard entry={entry} instructions={instructions.get(entry.slug)} />
  ))}
</div>
<div class="empty" id="empty" hidden>
  <p>Nothing on that hook.</p>
  <div class="actions" style="justify-content: center">
    <button type="button" class="btn ghost" data-clear>Clear filters</button>
    <a class="btn ghost" href="/submit">Add a bot</a>
  </div>
</div>
