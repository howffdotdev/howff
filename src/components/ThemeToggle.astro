---
// aria-label is corrected by theme.js once the resolved theme is known; the
// server cannot know whether the visitor prefers light.
---
<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Switch theme"
  title="Switch theme"
>
  <svg class="icon-moon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M13 9.8A5.6 5.6 0 0 1 6.2 3 5.6 5.6 0 1 0 13 9.8Z"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
  </svg>
  <svg class="icon-sun" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.4" />
    <path
      d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    />
  </svg>
</button>
