---
import { RUNTIME_LABEL } from '../lib/entries.js';

const { entry } = Astro.props;
const search = [
  entry.name,
  entry.slug,
  entry.tagline,
  entry.description,
  entry.author,
  entry.license,
  entry.type,
  ...entry.tags,
  ...entry.runtimes,
].join(' ').toLowerCase();
---
<a
  class="card"
  href={`/${entry.slug}`}
  data-entry
  data-type={entry.type}
  data-runtimes={entry.runtimes.join(' ')}
  data-tags={entry.tags.join(' ')}
  data-search={search}
>
  <span class={`badge ${entry.type}`}>{entry.type}</span>
  <div>
    <h2>{entry.name}</h2>
    <p>{entry.tagline}</p>
    <div class="chips">
      {entry.runtimes.map((r) => <span class="chip">{RUNTIME_LABEL[r] ?? r}</span>)}
      {entry.tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}
    </div>
  </div>
  <div class="meta">
    <div>{entry.license ?? 'licence n/a'}</div>
    <div>{entry.author ?? ''}</div>
  </div>
</a>
