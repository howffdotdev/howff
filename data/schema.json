{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howff.dev/schema/entry.json",
  "title": "Howff catalogue entry",
  "description": "One Grok Bot. Documentation only: scripts/validate.js is the gate and enforces cross-file rules this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "category",
    "tagline",
    "description",
    "integrations",
    "add",
    "instructions",
    "source",
    "homepage",
    "license",
    "author",
    "tags",
    "verified",
    "added",
    "notes"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "productivity",
        "development",
        "marketing",
        "sales",
        "ops",
        "personal",
        "research",
        "writing",
        "finance",
        "fun"
      ]
    },
    "tagline": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "Slack",
          "Gmail",
          "Google Calendar",
          "Google Docs",
          "Google Drive",
          "Google Search Console",
          "GitHub",
          "Notion",
          "LinkedIn",
          "X",
          "Stripe",
          "Reddit"
        ]
      }
    },
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "hint"],
      "properties": {
        "kind": { "enum": ["share-link", "profile-url"] },
        "url": { "type": "string", "pattern": "^https?://" },
        "hint": { "type": ["string", "null"] }
      }
    },
    "instructions": {
      "type": ["string", "null"],
      "description": "Filename of the sibling markdown, always <slug>.md. Null only when add.kind is share-link."
    },
    "source": { "type": ["string", "null"], "pattern": "^https?://" },
    "homepage": { "type": ["string", "null"], "pattern": "^https?://" },
    "license": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "verified": { "type": "boolean" },
    "added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notes": { "type": ["string", "null"] }
  }
}
